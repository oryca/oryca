# Gateway configuration. Every value here has a working default except the two
# marked required. The process exits at startup if those are missing.
#
# Running the whole stack with docker compose? Use the .env file at the
# repository root instead; it wires these up for you.

ORYCA_GW_HOST=localhost
ORYCA_GW_PORT=9002

#
# Control plane (REQUIRED)
# The gateway pulls services, sources, transforms, and API keys from here, and
# authenticates every call with the shared secret.
#
ORYCA_GW_CP_BASE_URL=http://localhost:9001/control-plane/api/v1
ORYCA_GW_INTERNAL_SECRET=
ORYCA_GW_JWKS_URL=http://localhost:9001/control-plane/api/v1/.well-known/jwks.json

# How often to re-pull each kind of configuration (seconds).
ORYCA_GW_SERVICE_POLL_INTERVAL=60
ORYCA_GW_APIKEY_POLL_INTERVAL=30
# Redis pub/sub channel for real-time invalidation. Must match control-plane's
# ORYCA_CP_SYNC_CHANNEL. Empty = HTTP polling only.
ORYCA_GW_SYNC_CHANNEL=oryca:sync-events

#
# CORS
#
ORYCA_GW_ALLOW_ORIGIN=*

# Public origin the gateway is reached at. Response transformation uses it to
# rewrite upstream self-links so they point back through the gateway. Leave
# empty to infer it from each request.
ORYCA_GW_PUBLIC_URL=

# Safety net only, not a business limit. Set high enough not to reject large
# GeoJSON responses from map services. Format is 4x or 4xB where x is K, M, G, T, P.
ORYCA_GW_MAX_REQUEST_BODY=500M

#
# Redis
#
ORYCA_GW_REDIS_ADDRESS=127.0.0.1:6379
ORYCA_GW_REDIS_PASSWORD=
# Must match control-plane's ORYCA_API_REDIS_DB. Shared for both routing data and the log stream.
ORYCA_GW_REDIS_DB=0
ORYCA_GW_REDIS_POOL_SIZE=100
ORYCA_GW_REDIS_MIN_IDLE_CONNS=10
ORYCA_GW_REDIS_DIAL_TIMEOUT=5
ORYCA_GW_REDIS_READ_TIMEOUT=3
ORYCA_GW_REDIS_WRITE_TIMEOUT=3

# Response cache Redis. Leave empty to reuse the connection above. Set these
# only once you have a second Redis instance to move the cache onto.
ORYCA_GW_CACHE_REDIS_ADDRESS=
ORYCA_GW_CACHE_REDIS_PASSWORD=
ORYCA_GW_CACHE_REDIS_DB=

# Response cache. Fallback TTL in seconds when upstream sends no Cache-Control,
# and the size of the per-pod in-memory tier that sits in front of Redis (0 disables it).
ORYCA_GW_CACHE_DEFAULT_TTL=300
ORYCA_GW_CACHE_MEMORY_MB=256

#
# Upstream connections
#
ORYCA_GW_UPSTREAM_MAX_IDLE_CONNS=1000
ORYCA_GW_UPSTREAM_MAX_IDLE_CONNS_PER_HOST=100
ORYCA_GW_UPSTREAM_MAX_CONNS_PER_HOST=200
ORYCA_GW_UPSTREAM_IDLE_CONN_TIMEOUT=90
ORYCA_GW_UPSTREAM_TLS_HANDSHAKE_TIMEOUT=10
ORYCA_GW_UPSTREAM_RESPONSE_HEADER_TIMEOUT=30
ORYCA_GW_UPSTREAM_DIAL_TIMEOUT=30
ORYCA_GW_UPSTREAM_KEEP_ALIVE=30

#
# Circuit breaker, per upstream domain+path. Trips after N consecutive failures
# (5xx/408/429) and fails fast while open instead of waiting on a stuck upstream.
#
ORYCA_GW_CB_MAX_REQUESTS=5
ORYCA_GW_CB_INTERVAL_SEC=60
ORYCA_GW_CB_TIMEOUT_SEC=30
ORYCA_GW_CB_CONSECUTIVE_FAILURES=5
# Drop a breaker from memory after this many idle minutes (0 = never).
ORYCA_GW_CB_IDLE_EVICT_MIN=30

# console (default, compact one-liner) | json
LOG_FORMAT=console
