# Copy this file to .env, set the secret below, then run docker compose up -d
#
# Every other value has a working default for local development.

# ---------------------------------------------------------------------------
# Shared secret between the gateway and the control plane. The gateway sends it
# on every /internal/* call, and the control plane rejects requests without it.
# Anyone who has it can read every service and API key you have.
#
# There is no default. Generate one.
#
# macOS / Linux / Git Bash / WSL:
#   echo "ORYCA_INTERNAL_SECRET=$(openssl rand -hex 32)" >> .env
#
# Windows PowerShell (no openssl, no $(...) substitution there):
#   $b=New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b)
#   Add-Content .env "ORYCA_INTERNAL_SECRET=$(($b|%{$_.ToString('x2')}) -join '')"
#
# ---------------------------------------------------------------------------
ORYCA_INTERNAL_SECRET=

# Rotating it? Put the old value here first. The control plane accepts both
# until you remove it, so calls already in flight do not fail.
#ORYCA_INTERNAL_SECRET_PREV=

# ---------------------------------------------------------------------------
# First administrator account, created on the very first startup only.
#
# Leave the password EMPTY and the control plane generates a random one and
# prints it to its log exactly once, in a box marked ROOT ACCOUNT CREATED.
#
#   docker compose logs control-plane
#
# Set a password here instead if you would rather choose your own.
# ---------------------------------------------------------------------------
ORYCA_API_ROOT_EMAIL=admin@localhost
ORYCA_API_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Published ports on the host
# ---------------------------------------------------------------------------
ORYCA_PORTAL_PORT=3000
ORYCA_GATEWAY_PORT=9002
ORYCA_CONTROL_PLANE_PORT=9001

# ---------------------------------------------------------------------------
# Request logs kept for this many days before MongoDB expires them
# ---------------------------------------------------------------------------
ORYCA_API_LOG_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Where the portal's visitors reach the two services.
#
# The portal calls them from the browser, so these are the addresses your users
# type, not container names. They are read when a page is served, not when the
# image is built, so a restart is enough after changing them.
#
#   docker compose up -d portal
# ---------------------------------------------------------------------------
ORYCA_PORTAL_API_URL=http://localhost:9001/control-plane/api/v1
ORYCA_PORTAL_GATEWAY_URL=http://localhost:9002/gateway/api

# ---------------------------------------------------------------------------
# Outgoing email (SMTP). Read once at startup, so restart the control plane
# after changing any of them.
#
# Leave ORYCA_API_SMTP_HOST empty to disable email entirely: signup still
# works, but verify-email and forgot-password links cannot be sent, and an
# administrator has to verify accounts and reset passwords by hand.
#
# ORYCA_API_SMTP_AUTH=false sends without logging in (internal relay).
# ORYCA_API_SMTP_SENDER_EMAIL falls back to ORYCA_API_SMTP_USER when empty.
# The TTL values are the lifetime, in minutes, of the verify-email and
# set-password links.
# ---------------------------------------------------------------------------
#ORYCA_API_SMTP_HOST=
#ORYCA_API_SMTP_PORT=587
#ORYCA_API_SMTP_USER=
#ORYCA_API_SMTP_PASSWORD=
#ORYCA_API_SMTP_AUTH=true
#ORYCA_API_SMTP_TLS_SKIP_VERIFY=false
#ORYCA_API_SMTP_SENDER_NAME=Oryca
#ORYCA_API_SMTP_SENDER_EMAIL=
#ORYCA_API_MAIL_VERIFY_TTL_MIN=1440
#ORYCA_API_MAIL_RESET_TTL_MIN=1440
