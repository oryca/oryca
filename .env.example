# Copy this file to .env, then run: docker compose up
#
#   cp .env.example .env && docker compose up
#
# Every value below has a working default for local development. The one thing
# you must NOT leave as-is in production is ORYCA_INTERNAL_SECRET.

# ---------------------------------------------------------------------------
# Shared secret between the gateway and the control plane.
# The gateway sends it on every /internal/* call; the control plane rejects
# requests without it. Any random string works — change it before deploying.
# ---------------------------------------------------------------------------
ORYCA_INTERNAL_SECRET=dev-internal-secret-change-me

# ---------------------------------------------------------------------------
# First administrator account, created on the very first startup only.
#
# Leave the password EMPTY and the control plane generates a random one and
# prints it to its log exactly once:
#
#   docker compose logs control-plane | grep -A2 "ROOT ACCOUNT"
#
# Set a password here instead if you would rather choose your own.
# ---------------------------------------------------------------------------
ORYCA_API_ROOT_EMAIL=admin@localhost
ORYCA_API_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Published ports on the host
# ---------------------------------------------------------------------------
ORYCA_PORTAL_PORT=3000
ORYCA_GATEWAY_PORT=9002
ORYCA_CONTROL_PLANE_PORT=9001

# ---------------------------------------------------------------------------
# Request logs kept for this many days before MongoDB expires them
# ---------------------------------------------------------------------------
ORYCA_API_LOG_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Where the portal's visitors reach the two services.
#
# The portal calls them from the browser, so these are the addresses your users
# type — not container names. They are written into the page bundle while the
# image is built, so after changing them run:
#
#   docker compose build portal
# ---------------------------------------------------------------------------
ORYCA_PORTAL_API_URL=http://localhost:9001/control-plane/api/v1
ORYCA_PORTAL_GATEWAY_URL=http://localhost:9002/gateway/api
