#
# Server
#

ORYCA_API_HOST=http://localhost
ORYCA_API_PORT=9001

#
# Database
#

ORYCA_API_DB_URL=mongodb://localhost:27017
ORYCA_API_DB_NAME=oryca_control_plane
ORYCA_API_DB_MAX_POOL_SIZE=50
ORYCA_API_DB_MIN_POOL_SIZE=10
ORYCA_API_DB_SOCKET_TIMEOUT=20

#
# CORS
#
ORYCA_API_ALLOW_ORIGIN=*

#
# Auth Key
#
ORYCA_API_JWT_PRIVATE_KEY=auth-private.key
ORYCA_API_JWT_PUBLIC_KEY=auth-public.key

#
# Redis
#
ORYCA_API_REDIS_ADDRESS=127.0.0.1:6379
ORYCA_API_REDIS_PASSWORD=
ORYCA_API_REDIS_DB=0
ORYCA_API_REDIS_EXPIRES=1800
ORYCA_API_REDIS_ROUTING_TTL=86400
ORYCA_API_REDIS_POOL_SIZE=50
ORYCA_API_REDIS_MIN_IDLE_CONNS=10
ORYCA_API_REDIS_DIAL_TIMEOUT=5
ORYCA_API_REDIS_READ_TIMEOUT=3
ORYCA_API_REDIS_WRITE_TIMEOUT=3

ORYCA_INTERNAL_SECRET=

# HTTP server hardening, timeouts in seconds
ORYCA_API_BODY_LIMIT=10M
ORYCA_API_READ_HEADER_TIMEOUT=10
ORYCA_API_READ_TIMEOUT=60
ORYCA_API_IDLE_TIMEOUT=120

# LOG_FORMAT is "console" (default, compact one-liner) or "json" (structured JSON)
LOG_FORMAT=console

#
# First administrator, created on the first boot only. An empty password means
# one is generated and printed to the log once. Both empty = no root is created.
#
ORYCA_API_ROOT_EMAIL=admin@localhost
ORYCA_API_ROOT_PASSWORD=

#
# Request logs. How long MongoDB keeps them, and whether this instance is the
# one draining the gateway's log stream. Changing the retention is applied on the
# next boot (collMod), not only on a fresh database.
#
ORYCA_API_LOG_RETENTION_DAYS=14
ORYCA_API_LOG_CONSUMER_ENABLED=true

#
# Seed data (packages, configuration) ships inside the binary.
# Point this at a directory of YAML files to override it without rebuilding.
# The file names must match those in control-plane/seed/.
#
ORYCA_API_SEED_DIR=

#
# false holds new sign-ups unverified until an administrator approves them.
#
ORYCA_API_REGISTER_AUTO_VERIFY=false

#
# Real-time gateway sync, a Redis pub/sub channel. Must match the gateway's
# ORYCA_GW_SYNC_CHANNEL. Empty = no real-time push; the gateway still works fine
# on HTTP polling alone.
#
ORYCA_CP_SYNC_CHANNEL=oryca:sync-events