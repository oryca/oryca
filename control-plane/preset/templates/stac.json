{
  "key": "stac",
  "label": "STAC asset and catalog links",
  "reference": "https://stacspec.org/en",
  "referenceNote": "STAC Specification v1.0.0. built on top of OGC API - Features",
  "description": "Rewrites assets..href (actual data files) and $id (catalog/item self-reference) to route through the gateway, then strips the original api_key",
  "types": [
    "OGC_API_STAC"
  ],
  "match": {
    "path": "/*",
    "methods": [
      "GET"
    ]
  },
  "notes": [
    "assets often live on a different domain than the catalog. if so, hardcode the target URL ({{oryca_gateway_url}} only knows its own service)",
    "The append on $id only works if there's no existing api_key regex-replace rule on the same field"
  ],
  "rules": [
    {
      "type": "json",
      "target": "body",
      "action": "replace",
      "path": "$.features[*].assets..href",
      "conditions": [],
      "params": {
        "find": "https://upstream.example.com/api/assets/1.0",
        "replace": "{{oryca_gateway_url}}"
      }
    },
    {
      "type": "json",
      "target": "body",
      "action": "replace",
      "path": "$.features[*].assets..href",
      "conditions": [],
      "params": {
        "regex": "api_key=[^&]*",
        "replace": "{{oryca_auth}}"
      }
    },
    {
      "type": "json",
      "target": "body",
      "action": "replace",
      "path": "$.assets..href",
      "conditions": [],
      "params": {
        "find": "https://upstream.example.com/api/assets/1.0",
        "replace": "{{oryca_gateway_url}}"
      }
    },
    {
      "type": "json",
      "target": "body",
      "action": "replace",
      "path": "$.assets..href",
      "conditions": [],
      "params": {
        "regex": "api_key=[^&]*",
        "replace": "{{oryca_auth}}"
      }
    },
    {
      "type": "json",
      "target": "body",
      "action": "replace",
      "path": "$['$id']",
      "conditions": [],
      "params": {
        "find": "{{sourceUrl}}",
        "replace": "{{oryca_gateway_url}}"
      }
    },
    {
      "type": "json",
      "target": "body",
      "action": "append",
      "path": "$['$id']",
      "conditions": [],
      "params": {
        "value": "?{{oryca_auth}}",
        "separator": ""
      }
    }
  ]
}
